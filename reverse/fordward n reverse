#include <stdio.h>
#include <stdint.h>
#include <stdbool.h>

#include "driver/i2c.h"
#include "driver/gpio.h"
#include "freertos/FreeRTOS.h"
#include "freertos/task.h"
#include "esp_err.h"

#define I2C_PORT I2C_NUM_0

#define SDA_PIN 21
#define SCL_PIN 22

#define REVERSE_PIN 25

#define MCP4725_ADDR 0x60
#define MCP4725_VCC 5.0

#define THROTTLE_MIN 0.80
#define THROTTLE_MAX 3.60

// Tiempo entre cada incremento de throttle
#define STEP_DELAY_MS 100

// Tiempo de espera con throttle mínimo antes de cambiar dirección
#define REVERSE_DELAY_MS 2000


// ==================================================
// I2C
// ==================================================

void i2c_master_init(void)
{
    i2c_config_t conf = {
        .mode = I2C_MODE_MASTER,
        .sda_io_num = SDA_PIN,
        .scl_io_num = SCL_PIN,
        .sda_pullup_en = GPIO_PULLUP_ENABLE,
        .scl_pullup_en = GPIO_PULLUP_ENABLE,
        .master.clk_speed = 100000
    };

    ESP_ERROR_CHECK(
        i2c_param_config(I2C_PORT, &conf)
    );

    ESP_ERROR_CHECK(
        i2c_driver_install(
            I2C_PORT,
            conf.mode,
            0,
            0,
            0
        )
    );
}


// ==================================================
// REVERSE
// ==================================================

void reverse_init(void)
{
    gpio_config_t io_conf = {
        .pin_bit_mask = (1ULL << REVERSE_PIN),
        .mode = GPIO_MODE_OUTPUT,
        .pull_up_en = GPIO_PULLUP_DISABLE,
        .pull_down_en = GPIO_PULLDOWN_DISABLE,
        .intr_type = GPIO_INTR_DISABLE
    };

    ESP_ERROR_CHECK(
        gpio_config(&io_conf)
    );

    // Arrancar en FORWARD
    gpio_set_level(REVERSE_PIN, 0);
}


void set_reverse(bool reverse)
{
    if (reverse)
    {
        /*
         * GPIO25 HIGH
         *
         * 2N2222 conduce
         *
         * REVERSE del BLDC -> 0 V
         */

        gpio_set_level(REVERSE_PIN, 1);

        printf("\n");
        printf("====================================\n");
        printf("        REVERSE ACTIVATED\n");
        printf("        REVERSE = 0 V\n");
        printf("====================================\n\n");
    }
    else
    {
        /*
         * GPIO25 LOW
         *
         * 2N2222 apagado
         *
         * REVERSE del BLDC -> ~4.60 V
         */

        gpio_set_level(REVERSE_PIN, 0);

        printf("\n");
        printf("====================================\n");
        printf("        FORWARD ACTIVATED\n");
        printf("        REVERSE = ~4.60 V\n");
        printf("====================================\n\n");
    }
}


// ==================================================
// MCP4725 THROTTLE
// ==================================================

void set_throttle_voltage(float voltage)
{
    if (voltage < THROTTLE_MIN)
        voltage = THROTTLE_MIN;

    if (voltage > THROTTLE_MAX)
        voltage = THROTTLE_MAX;

    uint16_t value =
        (uint16_t)(
            (voltage / MCP4725_VCC) * 4095.0
        );

    uint8_t data[3];

    data[0] = 0x40;
    data[1] = value >> 4;
    data[2] = (value & 0x0F) << 4;

    i2c_cmd_handle_t cmd =
        i2c_cmd_link_create();

    i2c_master_start(cmd);

    i2c_master_write_byte(
        cmd,
        (MCP4725_ADDR << 1) | I2C_MASTER_WRITE,
        true
    );

    i2c_master_write(
        cmd,
        data,
        3,
        true
    );

    i2c_master_stop(cmd);

    esp_err_t err =
        i2c_master_cmd_begin(
            I2C_PORT,
            cmd,
            pdMS_TO_TICKS(100)
        );

    i2c_cmd_link_delete(cmd);

    printf(
        "THROTTLE = %.2f V | DAC = %d | %s\n",
        voltage,
        value,
        esp_err_to_name(err)
    );
}


// ==================================================
// SUBIR THROTTLE
// ==================================================

void throttle_up(void)
{
    printf("\n");
    printf("THROTTLE UP\n");

    for (
        float voltage = THROTTLE_MIN;
        voltage <= THROTTLE_MAX;
        voltage += 0.01
    )
    {
        set_throttle_voltage(voltage);

        vTaskDelay(
            pdMS_TO_TICKS(STEP_DELAY_MS)
        );
    }

    // Asegurar exactamente 3.60 V
    set_throttle_voltage(THROTTLE_MAX);
}


// ==================================================
// BAJAR THROTTLE
// ==================================================

void throttle_down(void)
{
    printf("\n");
    printf("THROTTLE DOWN\n");

    for (
        float voltage = THROTTLE_MAX;
        voltage >= THROTTLE_MIN;
        voltage -= 0.01
    )
    {
        set_throttle_voltage(voltage);

        vTaskDelay(
            pdMS_TO_TICKS(STEP_DELAY_MS)
        );
    }

    // Asegurar exactamente 0.80 V
    set_throttle_voltage(THROTTLE_MIN);
}


// ==================================================
// MAIN
// ==================================================

void app_main(void)
{
    printf("\n");
    printf("========================================\n");
    printf(" ESP32 + MCP4725 + 2N2222\n");
    printf(" MANETA AUTOMATIZADA\n");
    printf("========================================\n");

    i2c_master_init();
    reverse_init();


    while (1)
    {
        // ==========================================
        // FORWARD
        // ==========================================

        set_reverse(false);

        // Throttle completamente liberado
        set_throttle_voltage(THROTTLE_MIN);

        vTaskDelay(
            pdMS_TO_TICKS(1000)
        );

        // Acelerar 0.80 -> 3.60 V
        throttle_up();


        // ==========================================
        // DESACELERAR
        // ==========================================

        throttle_down();


        // ==========================================
        // THROTTLE LIBERADO
        // ==========================================

        printf("\n");
        printf("THROTTLE RELEASED\n");
        printf("Waiting before reverse...\n");

        vTaskDelay(
            pdMS_TO_TICKS(REVERSE_DELAY_MS)
        );


        // ==========================================
        // REVERSE
        // ==========================================

        set_reverse(true);

        // Mantener throttle mínimo
        set_throttle_voltage(THROTTLE_MIN);

        vTaskDelay(
            pdMS_TO_TICKS(1000)
        );


        // ==========================================
        // ACELERAR EN REVERSE
        // ==========================================

        throttle_up();


        // ==========================================
        // DESACELERAR REVERSE
        // ==========================================

        throttle_down();


        // ==========================================
        // THROTTLE LIBERADO
        // ==========================================

        printf("\n");
        printf("THROTTLE RELEASED\n");
        printf("Waiting before forward...\n");

        vTaskDelay(
            pdMS_TO_TICKS(REVERSE_DELAY_MS)
        );


        // ==========================================
        // VOLVER A FORWARD
        // ==========================================

        set_reverse(false);

        set_throttle_voltage(THROTTLE_MIN);

        vTaskDelay(
            pdMS_TO_TICKS(1000)
        );
    }
}
